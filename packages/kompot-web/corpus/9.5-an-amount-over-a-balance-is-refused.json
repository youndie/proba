{
  "id": "9.5-an-amount-over-a-balance-is-refused",
  "clause": "§9.5",
  "title": "max_amount_from_field reads the balance out of a neighbour's metadata and blocks the submit",
  "why": "the rule is cross-field and local — it holds a person back before the request leaves — and a client that ignores it sends an amount the backend will refuse, after the wait",
  "form": {
    "formId": "f",
    "fields": [
      {
        "type": "autocomplete_field",
        "fieldId": "source",
        "dataSourceId": "accounts",
        "rules": []
      },
      {
        "type": "amount_field",
        "fieldId": "amount",
        "rules": [
          {
            "type": "max_amount_from_field",
            "balanceFieldId": "source",
            "errorMessage": "Not enough left"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "step": "set",
      "fieldId": "source",
      "value": {
        "type": "entity_value",
        "id": "acc-1",
        "title": "Current account",
        "rawMetadata": {
          "balance": "5000"
        }
      }
    },
    {
      "step": "set",
      "fieldId": "amount",
      "value": {
        "type": "amount_value",
        "long": 7000
      }
    },
    {
      "step": "submit"
    }
  ],
  "expect": {
    "errors": {
      "amount": "Not enough left"
    },
    "payloadBlocked": true
  }
}
