{
  "name": "kompot-web",
  "version": "0.1.0",
  "description": "A React renderer for kompot screens: the server describes a screen, the browser draws it",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "kompot": {
    "specVersion": "0.27.1.50",
    "repository": "https://reposilite.kotlin.website/snapshots",
    "tckVersion": "0.27.1.50"
  },
  "scripts": {
    "schema": "node scripts/fetch-schema.mjs",
    "schema:check": "node scripts/fetch-schema.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "corpus": "node scripts/fetch-corpus.mjs",
    "corpus:check": "node scripts/fetch-corpus.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
