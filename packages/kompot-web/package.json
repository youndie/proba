{
  "name": "kompot-web",
  "version": "0.1.0",
  "description": "A React renderer for kompot screens: the server describes a screen, the browser draws it",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "kompot": {
    "releases": "https://repo1.maven.org/maven2",
    "snapshots": "https://reposilite.kotlin.website/snapshots"
  },
  "scripts": {
    "schema": "node scripts/fetch-types.mjs",
    "schema:check": "node scripts/fetch-types.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "corpus": "node scripts/fetch-corpus.mjs",
    "corpus:check": "node scripts/fetch-corpus.mjs --check",
    "measure": "vite-node scripts/measure-layout.tsx"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
