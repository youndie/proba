{
  "$comment": "The vocabulary is a contract between the server and every client: a server can only NAME a token, never send a colour. Renaming one is a wire change. Changing a value is not.",
  "colors": {
    "light": {
      "surface": "#fbfbfa",
      "surface_raised": "#ffffff",
      "surface_sunken": "#f2f1ee",
      "on_surface": "#1c1b1a",
      "on_surface_muted": "#6b6865",
      "border": "#e2e0dc",
      "border_strong": "#c9c6c0",
      "accent": "#2f5ea8",
      "on_accent": "#ffffff",
      "severity_defect": "#a4302a",
      "severity_defect_surface": "#fbeceb",
      "severity_suspicion": "#8a6212",
      "severity_suspicion_surface": "#fbf3e2",
      "severity_undetermined": "#5d6b73",
      "severity_undetermined_surface": "#eef1f2"
    },
    "dark": {
      "surface": "#131312",
      "surface_raised": "#1c1c1b",
      "surface_sunken": "#0e0e0d",
      "on_surface": "#eae8e4",
      "on_surface_muted": "#9a9691",
      "border": "#2c2b29",
      "border_strong": "#45433f",
      "accent": "#8fb4ee",
      "on_accent": "#10233f",
      "severity_defect": "#ef8b83",
      "severity_defect_surface": "#33201e",
      "severity_suspicion": "#e0b25f",
      "severity_suspicion_surface": "#2e2617",
      "severity_undetermined": "#9fb0b8",
      "severity_undetermined_surface": "#1e2427"
    }
  },
  "typography": {
    "title_page": {
      "fontSize": "28px",
      "lineHeight": "34px",
      "fontWeight": 600,
      "letterSpacing": "-0.01em"
    },
    "title_section": {
      "fontSize": "19px",
      "lineHeight": "26px",
      "fontWeight": 600
    },
    "body": {
      "fontSize": "16px",
      "lineHeight": "25px",
      "fontWeight": 400
    },
    "body_small": {
      "fontSize": "14px",
      "lineHeight": "21px",
      "fontWeight": 400
    },
    "label": {
      "fontSize": "12px",
      "lineHeight": "16px",
      "fontWeight": 600,
      "letterSpacing": "0.06em",
      "textTransform": "uppercase"
    },
    "code": {
      "fontSize": "13.5px",
      "lineHeight": "21px",
      "fontWeight": 400,
      "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "code_small": {
      "fontSize": "12px",
      "lineHeight": "18px",
      "fontWeight": 400,
      "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace"
    }
  },
  "pairs": {
    "$comment": "Which foreground goes with which background. The wire has no way to say what colour text is, so without this the answer is whatever the browser inherits \u2014 which is how the first render of this design came out white on white.",
    "surface": "on_surface",
    "surface_raised": "on_surface",
    "surface_sunken": "on_surface_muted",
    "accent": "on_accent",
    "severity_defect_surface": "severity_defect",
    "severity_suspicion_surface": "severity_suspicion",
    "severity_undetermined_surface": "severity_undetermined"
  },
  "severity": {
    "$comment": "Colour is the last carrier, never the only one. A finding is read in a browser, in a terminal, in a screenshot pasted into an issue, and by someone who cannot tell the red from the ochre. Each severity therefore has a WORD, a SHAPE and only then a colour.",
    "defect": {
      "word": "defect",
      "shape": "solid",
      "ascii": "[!]",
      "color": "severity_defect",
      "surface": "severity_defect_surface"
    },
    "suspicion": {
      "word": "suspicion",
      "shape": "half",
      "ascii": "[?]",
      "color": "severity_suspicion",
      "surface": "severity_suspicion_surface"
    },
    "undetermined": {
      "word": "undetermined",
      "shape": "hollow",
      "ascii": "[ ]",
      "color": "severity_undetermined",
      "surface": "severity_undetermined_surface"
    }
  },
  "shapes": {
    "$comment": "Drawn out of the five modifier nodes the protocol has, because it has no border: solid is one background; hollow is a background with padding and a second background inside it, which the ordered chain makes a ring; half is a two-stop gradient. No glyph is involved \u2014 a font that lacks the character would move its neighbours and say nothing.",
    "sizeDp": 12,
    "ringDp": 2
  }
}
